<Project>
  <PropertyGroup>
    <CsWinRTIncludes>Microsoft.Gaming.XboxGameBar</CsWinRTIncludes>
  </PropertyGroup>

  <!-- Tras limpiar obj, VS puede saltarse MarkupCompilePass1 (incremental) y XamlPreCompile falla sin esta carpeta. -->
  <Target Name="EnsureIntermediateXamlDirectory"
          BeforeTargets="XamlPreCompile;MarkupCompilePass1;DesignTimeMarkupCompilationCT"
          Condition="'@(Page)' != '' Or '@(ApplicationDefinition)' != ''">
    <MakeDir Directories="$(XamlGeneratedOutputPath)intermediatexaml\" />
  </Target>

  <Target Name="AddGameBarCsWinRTInputs" BeforeTargets="CsWinRTGenerateProjection">
    <ItemGroup>
      <CsWinRTInputs Include="$(PkgMicrosoft_Gaming_XboxGameBar)\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd" />
      <CsWinRTInputs Include="$(PkgMicrosoft_Gaming_XboxGameBar)\private\Microsoft.Gaming.XboxGameBar.Private.winmd" />
    </ItemGroup>
  </Target>

  <!-- VS "Crear paquetes" ejecuta MakeAppx sobre bin\Platform\Config\AppX (LayoutDir del appxrecipe). -->
  <Target Name="EnsureVisualStudioAppXLayout"
          AfterTargets="GenerateMsixPackage"
          Condition="'$(AppxPackage)' == 'true' and Exists('$(AppxPackageRecipe)')">
    <PropertyGroup>
      <_SyncAppXLayoutScript>$(MSBuildProjectDirectory)\..\..\scripts\Sync-AppXLayout.ps1</_SyncAppXLayoutScript>
      <_VsAppXLayout>$(TargetDir)AppX</_VsAppXLayout>
    </PropertyGroup>
    <Message Importance="high" Text="Sync-AppXLayout: si falla, cierra el widget Gemini Assistant en Game Bar antes de recompilar." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_SyncAppXLayoutScript)&quot; -RecipePath &quot;$(AppxPackageRecipe)&quot; -LayoutDir &quot;$(_VsAppXLayout)&quot;" />
  </Target>

</Project>
