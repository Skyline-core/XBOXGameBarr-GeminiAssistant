<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>AppContainerExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>GeminiAssistant</RootNamespace>
    <AssemblyName>GeminiAssistant</AssemblyName>
    <DefaultLanguage>es-ES</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseUwp>true</UseUwp>
    <UseUwpTools>true</UseUwpTools>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- AppContainerExe no cuenta como ejecutable en el SDK; el apphost genera GeminiAssistant.exe para el manifiesto. -->
    <UseAppHost>true</UseAppHost>
    <_IsExecutable>true</_IsExecutable>
    <!-- Sin esto el apphost usa subsistema consola y aparece una ventana CMD. -->
    <_UseWindowsGraphicalUserInterface>true</_UseWindowsGraphicalUserInterface>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackage>true</AppxPackage>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <!-- Certificado de dev solo en Debug; Release usa el certificado de Partner Center (asociacion Store). -->
    <PackageCertificateKeyFile Condition="'$(Configuration)' == 'Debug' and Exists('$(MSBuildProjectDirectory)\GeminiAssistant_TemporaryKey.pfx')">GeminiAssistant_TemporaryKey.pfx</PackageCertificateKeyFile>
    <PackageCertificatePassword Condition="'$(Configuration)' == 'Debug' and '$(PackageCertificateKeyFile)' != ''">GeminiAssistant</PackageCertificatePassword>
    <AppxPackageSigningEnabled Condition="'$(PackageCertificateKeyFile)' != '' or '$(PackageCertificateThumbprint)' != ''">true</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="'$(PackageCertificateKeyFile)' == '' and '$(PackageCertificateThumbprint)' == ''">false</AppxPackageSigningEnabled>
    <DeployOnBuild Condition="'$(Configuration)' == 'Debug'">true</DeployOnBuild>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.1</Version>
    <Description>Xbox Game Bar widget with Gemini AI assistant</Description>
    <GameBarRuntimeNativePath Condition="'$(Platform)' == 'x64'">win10-x64</GameBarRuntimeNativePath>
    <GameBarRuntimeNativePath Condition="'$(Platform)' == 'x86'">win10-x86</GameBarRuntimeNativePath>
    <GameBarRuntimeNativePath Condition="'$(Platform)' == 'ARM64'">win10-arm64</GameBarRuntimeNativePath>
    <GameBarRuntimeNativePath Condition="'$(GameBarRuntimeNativePath)' == ''">win10-x64</GameBarRuntimeNativePath>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="7.3.2506120" GeneratePathProperty="true">
      <ExcludeAssets>compile;runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260518100" />
  </ItemGroup>

  <ItemGroup>
    <WindowsMetadataReference Include="$(PkgMicrosoft_Gaming_XboxGameBar)\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd" MatchImplementationDllName="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgMicrosoft_Gaming_XboxGameBar)\runtimes\$(GameBarRuntimeNativePath)\native\Microsoft.Gaming.XboxGameBar.dll" Link="Microsoft.Gaming.XboxGameBar.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Gaming_XboxGameBar)\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd" Link="Microsoft.Gaming.XboxGameBar.winmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Properties\Default.rd.xml" />
    <Content Include="Assets\**\*" />
    <Content Include="GameBar\**\*" />
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <None Include="Package.StoreAssociation.xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\EnglishResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EnglishResources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.en-US.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\EnglishResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>EnglishResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
