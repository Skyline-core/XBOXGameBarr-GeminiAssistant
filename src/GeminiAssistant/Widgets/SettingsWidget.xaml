<Page
    x:Class="GeminiAssistant.Widgets.SettingsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF1A1A2E">

    <Grid Padding="20">
        <StackPanel VerticalAlignment="Center" MaxWidth="400">
            <TextBlock Text="Ajustes � Gemini Assistant" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Text="API key de Google AI Studio" Margin="0,0,0,6" Opacity="0.8" />
            <PasswordBox x:Name="ApiKeyBox" PlaceholderText="Pega tu API key" Margin="0,0,0,12" />
            <Button Content="Guardar" Click="Save_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="SavedText" Foreground="#FF4ADE80" Margin="0,12,0,0" Visibility="Collapsed" />
            <TextBlock TextWrapping="Wrap" Opacity="0.65" Margin="0,20,0,0" FontSize="12"
                       Text="La clave se guarda solo en este equipo. Obt�n una en aistudio.google.com/apikey" />
            <TextBlock Text="Captura de pantalla" FontWeight="SemiBold" Margin="0,24,0,6" Opacity="0.9" />
            <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                       Text="Al pulsar Capturar, Windows puede pedir permiso (elige Permitir). Si falla: Configuracion &gt; Privacidad y seguridad &gt; Capturas de pantalla &gt; Gemini Assistant. Haz clic en el juego antes de capturar si Game Bar esta abierto." />
        </StackPanel>
    </Grid>
</Page>
