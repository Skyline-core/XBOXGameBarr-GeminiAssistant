<Page
    x:Class="GeminiAssistant.Widgets.SettingsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="#FF1A1A2E">

    <Page.Resources>
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFE6E1E5" />
        <SolidColorBrush x:Key="SettingsSubtextBrush" Color="#FF938F99" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <Grid Padding="20">
            <StackPanel VerticalAlignment="Top" MaxWidth="420">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"
                           Foreground="{StaticResource SettingsTextBrush}" />

                <TextBlock x:Name="LanguageLabel" Margin="0,0,0,6" Opacity="0.8"
                           Foreground="{StaticResource SettingsSubtextBrush}" />
                <ComboBox x:Name="LanguageCombo" Margin="0,0,0,20" HorizontalAlignment="Stretch"
                          Foreground="{StaticResource SettingsTextBrush}" />

                <TextBlock x:Name="ApiKeyLabel" Margin="0,0,0,6" Opacity="0.8"
                           Foreground="{StaticResource SettingsSubtextBrush}" />
                <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,12" />
                <TextBlock x:Name="ApiKeyHintText" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,20" FontSize="12"
                           Foreground="{StaticResource SettingsSubtextBrush}" />

                <TextBlock x:Name="SteamKeyLabel" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.9"
                           Foreground="{StaticResource SettingsTextBrush}" />
                <PasswordBox x:Name="SteamApiKeyBox" Margin="0,0,0,8" />
                <TextBlock x:Name="SteamIdLabel" Margin="0,0,0,6" Opacity="0.8"
                           Foreground="{StaticResource SettingsSubtextBrush}" />
                <TextBox x:Name="SteamIdBox" PlaceholderText="76561198000000000" Margin="0,0,0,12"
                         Foreground="{StaticResource SettingsTextBrush}" />
                <TextBlock x:Name="SteamHintText" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,20" FontSize="12"
                           Foreground="{StaticResource SettingsSubtextBrush}" />

                <Button x:Name="SaveButton" Click="Save_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="SavedText" Foreground="#FF4ADE80" Margin="0,12,0,0" Visibility="Collapsed" />

                <TextBlock x:Name="CaptureTitleText" FontWeight="SemiBold" Margin="0,24,0,6" Opacity="0.9"
                           Foreground="{StaticResource SettingsTextBrush}" />
                <TextBlock x:Name="CaptureHintText" TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                           Foreground="{StaticResource SettingsSubtextBrush}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
