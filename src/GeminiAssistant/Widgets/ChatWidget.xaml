<Page
    x:Class="GeminiAssistant.Widgets.ChatWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF1A1A2E">

    <Grid x:Name="RootGrid" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF252545" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Juego / app activa" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock x:Name="GameContextText" Text="Detectando..." FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#FFFFB347" FontSize="12"
                   Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed" />

        <ListView x:Name="MessagesList" Grid.Row="2" Margin="0,0,0,8" SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4" MaxWidth="360">
                        <TextBlock Text="{Binding RoleLabel}" FontSize="11" Opacity="0.6"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="{Binding AttachmentCaption}" FontSize="11" Opacity="0.75"
                                   Visibility="{Binding AttachmentVisibility}"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border x:Name="ScreenshotPreviewPanel" Grid.Row="3" Background="#FF252545"
                CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="ScreenshotPreview" Width="80" Height="45" Stretch="Uniform" Visibility="Collapsed" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ScreenshotPreviewLabel" Text="Captura lista para enviar" FontSize="12" TextWrapping="Wrap" />
                    <Button Content="Quitar" Click="RemoveScreenshot_Click" FontSize="11" Margin="0,6,0,0"
                            IsTabStop="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" PlaceholderText="Pregunta a Gemini..."
                     AcceptsReturn="False" IsTextPredictionEnabled="False"
                     KeyDown="InputBox_KeyDown" />
            <Button Grid.Column="1" Content="Enviar" Click="Send_Click" Margin="8,0,0,0"
                    IsTabStop="False" />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button x:Name="CaptureButton" Content="Capturar" Click="Capture_Click" Margin="0,0,8,0"
                    IsTabStop="False" />
            <Button x:Name="MicButton" Content="Microfono" Click="Mic_Click" Margin="0,0,8,0"
                    IsTabStop="False" />
            <Button Content="Limpiar chat" Click="ClearChat_Click" Margin="0,0,8,0" IsTabStop="False" />
            <Button Content="Ver log" Click="ShowLog_Click" IsTabStop="False" />
        </StackPanel>
    </Grid>
</Page>
