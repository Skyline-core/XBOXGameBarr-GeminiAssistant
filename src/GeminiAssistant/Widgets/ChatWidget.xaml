<Page
    x:Class="GeminiAssistant.Widgets.ChatWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GeminiAssistant.Widgets"
    Background="#FF1B1B1F">

    <Page.Resources>
        <SolidColorBrush x:Key="GwBgBrush" Color="#FF1B1B1F" />
        <SolidColorBrush x:Key="GwSurfaceBrush" Color="#FF2D2D37" />
        <SolidColorBrush x:Key="GwSurfaceHighBrush" Color="#FF353545" />
        <SolidColorBrush x:Key="GwBorderBrush" Color="#FF3A3A48" />
        <SolidColorBrush x:Key="GwDividerBrush" Color="#FF2E2E38" />
        <SolidColorBrush x:Key="GwTextPrimaryBrush" Color="#FFE6E1E5" />
        <SolidColorBrush x:Key="GwTextSecondaryBrush" Color="#FF938F99" />
        <SolidColorBrush x:Key="GwAccentBrush" Color="#FF6750A4" />
        <SolidColorBrush x:Key="GwAccentHoverBrush" Color="#FF7965AF" />
        <SolidColorBrush x:Key="GwUserBubbleBrush" Color="#FF4A3F6B" />
        <SolidColorBrush x:Key="GwAiBubbleBrush" Color="#FF2D2D37" />
        <SolidColorBrush x:Key="GwAvatarUserBrush" Color="#FF4A4458" />
        <SolidColorBrush x:Key="GwStatusBrush" Color="#FFF9C858" />

        <Style x:Key="GwIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFCAC4D0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="GwFabStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D37" />
            <Setter Property="BorderBrush" Value="#FF3A3A48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFCAC4D0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="GwInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource GwTextPrimaryBrush}" />
            <Setter Property="PlaceholderForeground" Value="#FF625B71" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="BorderElement"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                <ScrollViewer x:Name="ContentElement"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Hidden"
                                              ZoomMode="Disabled"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalScrollMode="Disabled" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GwInputPillButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFCAC4D0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="36" Height="36">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="#FF353545">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GwSendButtonStyle" TargetType="Button" BasedOn="{StaticResource GwInputPillButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="36" Height="36">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="#FF6750A4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GwChipIconButtonStyle" TargetType="Button" BasedOn="{StaticResource GwInputPillButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="32" Height="32">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GwSuggestionStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D37" />
            <Setter Property="BorderBrush" Value="#FF3A3A48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFE6E1E5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <DataTemplate x:Key="GeminiMessageTemplate">
            <Grid Margin="0,5" HorizontalAlignment="Left" MaxWidth="320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14" Margin="0,2,8,0"
                        Background="{StaticResource GwSurfaceBrush}"
                        BorderBrush="#FF4A4458" BorderThickness="1"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding AvatarGlyph}" FontSize="12" Foreground="#FFD0BCFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <Border Background="{StaticResource GwAiBubbleBrush}" CornerRadius="4,20,20,20"
                            Padding="14,9" MaxWidth="280">
                        <StackPanel>
                            <TextBlock Text="{Binding AttachmentCaption}" FontSize="11" Opacity="0.8"
                                       Visibility="{Binding AttachmentVisibility}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                       IsTextSelectionEnabled="True" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource GwTextPrimaryBrush}"
                                       FontSize="13" LineHeight="20" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="UserMessageTemplate">
            <Grid Margin="0,5" HorizontalAlignment="Right" MaxWidth="320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Right">
                    <Border Background="{StaticResource GwUserBubbleBrush}" CornerRadius="20,4,20,20"
                            Padding="14,9" MaxWidth="280" HorizontalAlignment="Right">
                        <StackPanel>
                            <Border Width="200" Height="112" CornerRadius="10" Margin="0,0,0,6"
                                    Background="#FF353545"
                                    Visibility="{Binding ThumbnailVisibility}">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding AttachmentCaption}" FontSize="11" Opacity="0.85"
                                       Visibility="{Binding AttachmentVisibility}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                       IsTextSelectionEnabled="True" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource GwTextPrimaryBrush}"
                                       FontSize="13" LineHeight="20" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Margin="8,2,0,0"
                        Background="{StaticResource GwAvatarUserBrush}"
                        BorderBrush="{StaticResource GwAccentBrush}" BorderThickness="2"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding AvatarGlyph}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FFCAC4D0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <local:ChatMessageTemplateSelector x:Key="MessageTemplateSelector"
            UserMessageTemplate="{StaticResource UserMessageTemplate}"
            GeminiMessageTemplate="{StaticResource GeminiMessageTemplate}" />
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource GwBgBrush}" Padding="0,12,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Padding="20,4,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="16"
                    Background="{StaticResource GwAvatarUserBrush}"
                    BorderBrush="{StaticResource GwAccentBrush}" BorderThickness="2">
                <TextBlock x:Name="ProfileInitialsText" Text="TU" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFCAC4D0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TopTitleText" Grid.Column="1" Text="Gemini" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
            <Button x:Name="HomeButton" Grid.Column="2" Style="{StaticResource GwIconButtonStyle}"
                    Click="Home_Click" ToolTipService.ToolTip="Inicio">
                <FontIcon Glyph="&#xE10F;" FontSize="18" />
            </Button>
            <Button x:Name="MenuButton" Grid.Column="3" Style="{StaticResource GwIconButtonStyle}"
                    ToolTipService.ToolTip="Mas opciones">
                <FontIcon Glyph="&#xE712;" FontSize="18" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="MenuSettingsItem" Click="MenuSettings_Click" />
                        <MenuFlyoutItem x:Name="MenuClearItem" Click="ClearChat_Click" />
                        <MenuFlyoutItem x:Name="MenuLogItem" Click="ShowLog_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Indicador de juego activo -->
        <Border x:Name="GameIndicatorPanel" Grid.Row="1"
                Background="{StaticResource GwSurfaceBrush}"
                BorderBrush="{StaticResource GwBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="10,7" Margin="20,8,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" Background="#FF1A2D4A" Margin="0,0,10,0">
                    <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="#FFA8C7FA"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GameIndicatorLabel" Text="Juego activo" FontSize="10"
                               Foreground="{StaticResource GwTextSecondaryBrush}" />
                    <TextBlock x:Name="GameIndicatorText" Text="Detectando juego..." FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource GwTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                <Ellipse x:Name="GameTrackingDot" Grid.Column="2" Width="8" Height="8"
                         Fill="#FF625B71" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource GwStatusBrush}"
                   FontSize="11" Margin="20,6,20,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- Main: home or chat -->
        <Grid Grid.Row="3" Margin="20,8,20,0">
            <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                <StackPanel VerticalAlignment="Bottom" Padding="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource GwSurfaceBrush}"
                                Margin="0,0,10,0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Row="0" Grid.Column="0" Width="6" Height="6" Fill="#FFA8C7FA" Margin="1" />
                                <Ellipse Grid.Row="0" Grid.Column="1" Width="6" Height="6" Fill="#FFF28B82" Margin="1" />
                                <Ellipse Grid.Row="1" Grid.Column="0" Width="6" Height="6" Fill="#FFF9C858" Margin="1" />
                                <Ellipse Grid.Row="1" Grid.Column="1" Width="6" Height="6" Fill="#FFB5CCB8" Margin="1" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HomeGeminiTitleText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource GwTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="GreetingText" Text="Hola" FontSize="13"
                               Foreground="{StaticResource GwTextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBlock x:Name="GreetingHelpText" FontSize="24" LineHeight="30" Margin="0,0,0,6"
                               Foreground="#FFD0BCFF" />
                    <TextBlock x:Name="GameContextText" Text="Detectando juego..." FontSize="11"
                               Foreground="{StaticResource GwTextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,20" Opacity="0.9" />

                    <Button Style="{StaticResource GwSuggestionStyle}" Click="SuggestionGames_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="10" Background="#FF1A2D4A" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="#FFA8C7FA"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SuggestionGamesTitle" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="SuggestionGamesSub" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GwSuggestionStyle}" Click="SuggestionAchievements_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="10" Background="#FF302A14" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE735;" FontSize="16" Foreground="#FFF9C858"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SuggestionSteamTitle" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="SuggestionSteamSub" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GwSuggestionStyle}" Click="SuggestionCapture_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="10" Background="#FF1A2E1E" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE722;" FontSize="16" Foreground="#FFB5CCB8"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SuggestionCaptureTitle" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock x:Name="SuggestionCaptureSub" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ChatPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FabCaptureButton" Style="{StaticResource GwFabStyle}" Click="Capture_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE722;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="FabCaptureText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GwFabStyle}" Click="FabAchievements_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE735;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="FabAchievementsText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GwFabStyle}" Click="FabTips_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE706;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="FabTipsText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GwFabStyle}" Click="FabStats_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE9D2;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="FabStatsText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource GwDividerBrush}" Margin="0,0,0,8" />

                <ListView x:Name="MessagesList" Grid.Row="2" SelectionMode="None"
                          IsItemClickEnabled="False" ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                          Background="Transparent" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>

        <!-- Zona inferior: chip de captura + barra de entrada -->
        <StackPanel Grid.Row="4" Margin="20,8,20,0">
            <Border x:Name="ScreenshotPreviewPanel" Background="{StaticResource GwSurfaceBrush}"
                    BorderBrush="{StaticResource GwBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="40" CornerRadius="8" Background="#FF353545"
                            VerticalAlignment="Center">
                        <Grid>
                            <FontIcon x:Name="ScreenshotPreviewPlaceholder" Glyph="&#xE722;"
                                      FontSize="18" Foreground="#FFB5CCB8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="ScreenshotPreview" Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   Canvas.ZIndex="1" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ScreenshotPreviewLabel" Grid.Column="1" Margin="10,0,8,0"
                               VerticalAlignment="Center" FontSize="12" LineHeight="18"
                               TextWrapping="Wrap" Foreground="{StaticResource GwTextPrimaryBrush}" />
                    <Button x:Name="RemoveScreenshotButton" Grid.Column="2" Style="{StaticResource GwChipIconButtonStyle}"
                            Click="RemoveScreenshot_Click"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource GwTextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="InputBarBorder" Height="48" Background="{StaticResource GwSurfaceBrush}"
                    BorderBrush="{StaticResource GwBorderBrush}" BorderThickness="1"
                    CornerRadius="24" Padding="4,4,4,4">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0" Style="{StaticResource GwInputTextBoxStyle}"
                             PlaceholderText="Pregúntame lo que quieras"
                             Margin="14,0,6,0"
                             AcceptsReturn="False" IsTextPredictionEnabled="False"
                             KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged" />
                    <Button x:Name="CaptureButton" Grid.Column="1" Style="{StaticResource GwInputPillButtonStyle}"
                            Click="Capture_Click" ToolTipService.ToolTip="Capturar pantalla">
                        <FontIcon Glyph="&#xE722;" FontSize="17" />
                    </Button>
                    <Button x:Name="MicButton" Grid.Column="2" Style="{StaticResource GwInputPillButtonStyle}"
                            Click="Mic_Click" Margin="4,0,0,0" ToolTipService.ToolTip="Grabar voz">
                        <FontIcon x:Name="MicButtonIcon" Glyph="&#xE720;" FontSize="17" />
                    </Button>
                    <Button x:Name="SendButton" Grid.Column="3" Style="{StaticResource GwSendButtonStyle}"
                            Click="Send_Click" Margin="4,0,0,0" ToolTipService.ToolTip="Enviar">
                        <FontIcon Glyph="&#xE74A;" FontSize="17" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
