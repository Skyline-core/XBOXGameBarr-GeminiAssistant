<Page
    x:Class="GeminiAssistant.Widgets.LaunchLandingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF1B1B1F">

    <Grid Padding="24">
        <StackPanel VerticalAlignment="Center" MaxWidth="360">
            <TextBlock x:Name="TitleText"
                       Text="Gemini Assistant"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FFE6E1E5"
                       Margin="0,0,0,12" />
            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="20"
                       Foreground="#FFCAC4D0"
                       Margin="0,0,0,12" />
            <TextBlock x:Name="HintText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="18"
                       Foreground="#FFA8C7FA"
                       Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</Page>
